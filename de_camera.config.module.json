{
    "module_id": "HorusEye",
    /* DroneEngage Communication Server */
    "s2s_udp_target_ip": "127.0.0.1", //"192.168.1.144",
    "s2s_udp_target_port": "60000",
    "s2s_udp_listening_ip": "0.0.0.0",
    "s2s_udp_listening_port": "60029",
    "s2s_udp_packet_size": "8192",
    "use_unix_socket"           : true,
    

    // === Camera Selection === (two mutually exclusive styles)
    "camera": {
        // Style 1: Scan range (recommended)
        //   Scans /dev/video<camera_start_index> through /dev/video<camera_end_index>
        //   and opens every device that exists.
        "camera_start_index": 0,
        "camera_end_index": 11

        // Style 2: Camera list (alternative to scan range)
        //   Uncomment to use an explicit list instead of scanning.
        // "camera_list": [
        //    {"name": "AI1", "device_num": 0}   // name should be unique across all cameras.
        //    ,{"name": "AI2", "device_name": "DE-CAM1"}
        //  ]
    },

    // === Streaming / Media Settings === (apply to all cameras regardless of selection style)
    "streaming": {
        // Capture resolution requested from the V4L2 device (MAX, not exact).
        // The driver picks the closest supported mode via GetBestMatchedCapability,
        // so cameras with lower native resolution simply use their own max.
        "capture_width": 1024,
        "capture_height": 720,
        "capture_fps": 30,

        // Video recording framerate (fps) passed to ffmpeg (MAX, not exact).
        // 0 = use capture_fps. If the camera delivers fewer fps, frames are written
        // as they arrive; do not set this higher than the camera's actual fps.
        "video_recording_fps": 10,

        // Stream downscale cap (WebRTC broadcaster). MAX, not exact: frames already
        // smaller than this are broadcast as-is. 0 or -1 = unlimited (no downscale).
        // Protects RPi CPU/bandwidth by capping the streamed resolution.
        "stream_max_width": 1280,
        "stream_max_height": 720,

        // Target resolution for the "small" GCS still image (MAX, not exact).
        // If the camera's native resolution is already at or below this, the full-res
        // image is sent to GCS. The locally saved still always keeps full capture res.
        // 0 or -1 = unlimited (send full resolution to GCS as well).
        "gcs_image_small_width": 320,
        "gcs_image_small_height": 200
    },
    //optional entry used to store video and images.
    "media_folder": "./img",
    // default: true
    "media_image_png": true,
    // default: true
    "send_image_gcs": true,
    "iceServers": [
        {
            "urls": "stun:airgap:3478",
            "username": "airgap",
            "password": "1234"
        }
    ]
}
